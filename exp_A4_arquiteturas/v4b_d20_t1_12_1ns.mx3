Msat  = 4.000000e+05
Aex   = 15e-12
alpha = 0.01
Ku1   = 8.810372e+05
anisU = vector(0, 0, 1)
Temp  = 0

DisableZhangLiTorque = true
Pol = 0.40
Lambda = 1
