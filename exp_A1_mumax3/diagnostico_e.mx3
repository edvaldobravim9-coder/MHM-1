// =====================================================================
// MHM-1 — Diagnóstico E: reversão determinística com dt = 20 fs
// (limite de estabilidade da troca para células de 1 nm ~ 20-60 fs).
// Se m_z -> -1 limpo, confirma que o dt=1 ps violava a estabilidade
// do modo de Nyquist da troca.
// =====================================================================

SetGridSize(40, 40, 1)
SetCellSize(1e-9, 1e-9, 1.5e-9)

Msat  = 600e3
Aex   = 15e-12
alpha = 0.01
Ku1   = 356e3
anisU = vector(0, 0, 1)
Temp  = 0
B_ext = vector(0, 0, -1.0)

m = Uniform(0.01, 0, 0.99995)

mz := m.Comp(2)
tableadd(mz)
tableadd(Edens_exch)
tableadd(Edens_total)
TableAutoSave(1e-12)

SetSolver(2)
FixDt = 2e-14

run(1e-9)
tablesave()
print("diagnostico E concluido")
