// refino J_sw: J = -7.000e+10 A/m2 (7.0 MA/cm2), 0 K, 5 ns
SetGridSize(14, 14, 1)
SetCellSize(2.5e-9, 2.5e-9, 1.5e-9)
Msat  = 600e3
Aex   = 15e-12
alpha = 0.01
Ku1   = 335e3
anisU = vector(0, 0, 1)
Temp  = 0

DisableZhangLiTorque = true
Pol = 0.40
Lambda = 1
EpsilonPrime = 0
FixedLayer = vector(0, 0, 1)
FixedLayerPosition = FIXEDLAYER_TOP
// SINAL: J negativo comuta P→AP (diag_stt_sinal.py)
J = vector(0, 0, -7.000000e+10)

m = Uniform(0.01, 0, 0.99995)
mz := m.Comp(2)
tableadd(mz)
TableAutoSave(1e-11)
run(5.0e-09)
tablesave()
